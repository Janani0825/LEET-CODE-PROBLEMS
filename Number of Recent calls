#include <stdlib.h>

typedef struct {
    int* queue;
    int head;
    int tail;
} RecentCounter;

RecentCounter* recentCounterCreate() {
    RecentCounter* obj = (RecentCounter*)malloc(sizeof(RecentCounter));
    obj->queue = (int*)malloc(10005 * sizeof(int));
    obj->head = 0;
    obj->tail = 0;
    return obj;
}

int recentCounterPing(RecentCounter* obj, int t) {
    obj->queue[obj->tail++] = t;
    
    int min_time = t - 3000;
    while (obj->head < obj->tail && obj->queue[obj->head] < min_time) {
        obj->head++;
    }
    
    return obj->tail - obj->head;
}

void recentCounterFree(RecentCounter* obj) {
    free(obj->queue);
    free(obj);
}
