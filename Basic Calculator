import java.util.Stack;
public class Solution {
    public int calculate(String s) {
        Stack<Integer> stack = new Stack<>();
        int sum = 0;
        int sign = 1;
        int n = s.length();

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);
            if (Character.isDigit(ch)) {
                int num = 0;
                while (i < n && Character.isDigit(s.charAt(i))) {
                    num = num * 10 + (s.charAt(i) - '0');
                    i++;
                }
                i--; 
                sum += num * sign;

            } else if (ch == '+') {
                sign = 1;

            } else if (ch == '-') {
                sign = -1;

            } else if (ch == '(') {
                stack.push(sum);
                stack.push(sign);
                sum = 0;
                sign = 1;

            } else if (ch == ')') {
                int boundarySign = stack.pop();
                sum *= boundarySign;
                int previousSum = stack.pop();
                sum += previousSum;
            }  
        }
        return sum;
    }

}
