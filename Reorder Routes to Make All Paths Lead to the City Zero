int minReorder(int n, int** connections, int connectionsSize,
               int* connectionsColSize) {

    int *head = malloc(n * sizeof(int));
    int *to = malloc(2 * (n - 1) * sizeof(int));
    int *next = malloc(2 * (n - 1) * sizeof(int));
    int *cost = malloc(2 * (n - 1) * sizeof(int));

    for (int i = 0; i < n; i++)
        head[i] = -1;

    int edge = 0;

    for (int i = 0; i < connectionsSize; i++) {

        int a = connections[i][0];
        int b = connections[i][1];
        to[edge] = b;
        cost[edge] = 1;
        next[edge] = head[a];
        head[a] = edge++;
        to[edge] = a;
        cost[edge] = 0;
        next[edge] = head[b];
        head[b] = edge++;
    }

    int *visited = calloc(n, sizeof(int));
    int *queue = malloc(n * sizeof(int));

    int front = 0;
    int rear = 0;
    int answer = 0;

    queue[rear++] = 0;
    visited[0] = 1;

    while (front < rear) {

        int city = queue[front++];

        int e = head[city];

        while (e != -1) {

            int nextCity = to[e];

            if (!visited[nextCity]) {

                visited[nextCity] = 1;

                answer += cost[e];

                queue[rear++] = nextCity;
            }

            e = next[e];
        }
    }

    free(head);
    free(to);
    free(next);
    free(cost);
    free(visited);
    free(queue);

    return answer;
}
