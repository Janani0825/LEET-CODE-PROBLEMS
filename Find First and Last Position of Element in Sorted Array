#include <stdlib.h>

int findBoundary(int* nums, int numsSize, int target, int findFirst) {
    int low = 0;
    int high = numsSize - 1;
    int boundIndex = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (nums[mid] == target) {
            boundIndex = mid;
            if (findFirst) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        } else if (nums[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    return boundIndex;
}

int* searchRange(int* nums, int numsSize, int target, int* returnSize) {
    *returnSize = 2; 
    int* result = (int*)malloc(2 * sizeof(int));
    
    result[0] = findBoundary(nums, numsSize, target, 1);
    result[1] = findBoundary(nums, numsSize, target, 0);
    
    return result;
}
