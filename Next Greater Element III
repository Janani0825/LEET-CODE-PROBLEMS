class Solution {
    public int nextGreaterElement(int n) {
        int temp = n;
        int count = 0;
        while (temp > 0) {
            count++;
            temp /= 10;
        }

        int[] digits = new int[count];
        temp = n;
        for (int i = 0; i < count; i++) {
            digits[i] = temp % 10;
            temp /= 10;
        }
        
        int i = 0;
        while (i < count - 1 && digits[i] <= digits[i + 1]) {
            i++;
        }

        if (i == count - 1) {
            return -1;
        }
        
        int j = 0;
        while (digits[j] <= digits[i + 1]) {
            j++;
        }
        
        int t = digits[i + 1];
        digits[i + 1] = digits[j];
        digits[j] = t;
        int start = 0;
        int end = i;
        while (start < end) {
            int swapTemp = digits[start];
            digits[start] = digits[end];
            digits[end] = swapTemp;
            start++;
            end--;
        }
        long result = 0;
        for (int k = count - 1; k >= 0; k--) {
            result = result * 10 + digits[k];
        }
        return result > Integer.MAX_VALUE ? -1 : (int) result;
    }
}
